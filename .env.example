# Copy to .env next to docker-compose.yml. Everything has a working default for local runs.

SECRET_KEY=replace-with-a-long-random-string
PUBLIC_API_URL=http://localhost:8010
ADMIN_ORIGIN=http://localhost:3010

# Any OpenAI-compatible chat endpoint. Leave the key empty to run in quote mode:
# the widget then answers with the best matching passage and its source.
# OPENAI_BASE_URL / OPENAI_API_KEY (or OPENROUTER_API_KEY) work as well.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4.1-mini
LLM_MAX_TOKENS=400

# local = fastembed (multilingual-e5-small, CPU), openai = EMBEDDINGS_BASE_URL/EMBEDDINGS_API_KEY
EMBEDDINGS_PROVIDER=local
# int8 build of the model; onnx/model.onnx is the full one (4x the memory). Run
# `python -m app.cli reembed` after switching.
EMBEDDINGS_MODEL_FILE=onnx/model_qint8_avx512_vnni.onnx

# Optional: Telegram handoff. Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Set to false if the bot token is shared with another service: Relay then only sends
# handoffs and leads to the chat and never reads updates. Managers reply in the admin.
TELEGRAM_RECEIVE_UPDATES=true

# Spend limits
DAILY_TOKEN_LIMIT=400000
WIDGET_RATE_PER_MINUTE=12
