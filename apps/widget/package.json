{
  "name": "@relay/widget",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --mode loader && vite build --mode app && node scripts/copy-to-api.mjs",
